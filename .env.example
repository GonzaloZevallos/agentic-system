# Root of the product repo. The system writes .agentic/ there and never inside its own repo (ADR-0002).
AGENTIC_PRODUCT_DIR=../gym-saas

# Optional. Any Configuration field can be overridden as AGENTIC_<FIELD>.
# AGENTIC_THINKER_MODEL=claude-sonnet-5
# AGENTIC_VALIDATOR_MODEL=claude-opus-5
# AGENTIC_MAX_RETURNS_PER_PAIR=2
# AGENTIC_ROLE_RETRIES=1
# Money cap of one attempt of any role, a safety net (ADR-0004, adendas):
# AGENTIC_MAX_BUDGET_USD=10
# Money cap of the whole task, checked before every attempt; reached, the task escalates and
# pauses. A base until the plan, then a share per subtask, under a ceiling (ADR-0004, adendas).
# `agentic resume --task-budget X` sets AGENTIC_TASK_BUDGET_USD, raising the cap for that run:
# AGENTIC_TASK_BUDGET_BASE_USD=30
# AGENTIC_TASK_BUDGET_PER_SUBTASK_USD=15
# AGENTIC_TASK_MAX_BUDGET_USD=250
# Model of every sub-agent a role spawns, the code-review skill's among them (ADR-0013, adenda):
# AGENTIC_SUBAGENT_MODEL=claude-sonnet-5
# How long each product check (.agentic/checks.yaml) may run in the delivery gate, seconds:
# AGENTIC_CHECK_TIMEOUT_S=600
# Identity of the system's commits in the product repo (ADR-0011):
# AGENTIC_GIT_AUTHOR_NAME=agentic-system
# AGENTIC_GIT_AUTHOR_EMAIL=agentic-system@users.noreply.github.com

# Optional. Telemetry (observability/README.md, ADR-0008, ADR-0037). Everything goes
# to the local collector, which sends traces -- Claude Code's and the system's own --
# to Langfuse, the only destination. Claude Code exports OpenTelemetry natively; the
# SDK subprocess inherits these. The system adds a span per task and per role to the
# same endpoint, so a task is one trace. Metrics are off: what used to be a metric is
# now a span attribute (task cost, rework, duration, returns), not a separate signal.
# CLAUDE_CODE_ENABLE_TELEMETRY=1
# CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # the collector; it adds the auth
# Label of every metric and trace: the system's short git SHA (+dirty) unless overridden.
# AGENTIC_SYSTEM_VERSION=
# Content is redacted unless these are on:
# OTEL_LOG_USER_PROMPTS=1
# OTEL_LOG_ASSISTANT_RESPONSES=1
# OTEL_LOG_TOOL_DETAILS=1
# OTEL_LOG_TOOL_CONTENT=1
